# 흔적 · Trace — 환경변수 템플릿
# `.env.local`로 복사 후 실제 값을 채우세요.
# Expo는 EXPO_PUBLIC_ 접두사가 있는 변수만 클라이언트 번들에 포함합니다.

# ---------------------------------------------------------------------------
# Supabase (모바일 앱)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 빌드 환경 식별자 (development / preview / production). EAS가 주입.
EXPO_PUBLIC_ENV=development

# Sentry DSN (선택)
EXPO_PUBLIC_SENTRY_DSN=

# Mixpanel 토큰 (선택, 개인정보 마스킹 정책 준수)
EXPO_PUBLIC_MIXPANEL_TOKEN=

# ---------------------------------------------------------------------------
# Supabase (B2B admin — admin/.env.local)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Edge Functions (Supabase 대시보드의 Function Secrets에 등록)
# 클라이언트 번들에는 절대 포함되지 않음.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role-key

# ai-meditation
# ANTHROPIC_API_KEY=sk-ant-xxxx

# payment-webhook (토스페이먼츠 웹훅 시그니처 검증)
# TOSS_SECRET_KEY=test_sk_xxxx
# TOSS_WEBHOOK_SECRET=whsec_xxxx

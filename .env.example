# 흔적 · Trace — 환경변수 템플릿
# `.env.local`로 복사 후 실제 값을 채우세요.

# Supabase (모바일 앱)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (B2B admin — admin/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Edge Functions (Supabase 대시보드의 Function 환경변수에 등록)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=          # ai-meditation
# TOSS_WEBHOOK_SECRET=        # payment-webhook HMAC 검증
